# <IfModule mod.rewrite.c>
#     RewriteEngine On
#     RewriteRule ^(.*)$ public/$1 [L]
# </IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule    ^$    public/    [L]
    RewriteRule    (.*) public/$1    [L]
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>
